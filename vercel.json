{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about-us",
      "destination": "/about.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact.html"
    },
    {
      "source": "/book",
      "destination": "/appointment.html"
    }
  ],
  "redirects": [
    {
      "destination": "https://shapeurmind.sanity.studio/",
      "source": "/studio",
      "permanent": false
    },
    {
      "destination": "https://shapeurmind.sanity.studio/:path*",
      "source": "/studio/:path*",
      "permanent": false
    }
  ]
}
